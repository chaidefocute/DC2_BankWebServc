@model BankMvc.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<h2>Sign in</h2>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Login" method="post">
            @* wrong username / password and other errors show here *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Sign in</button>
            <a class="btn btn-link" asp-action="Register">Don't have a profile? Register</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
