@model BankMvc.Models.UserDto
@using System.Security.Claims
@{
    ViewData["Title"] = "Manage " + Model.Username;
    var isMe = User.FindFirstValue(ClaimTypes.NameIdentifier) == Model.UserId.ToString();
}

<h2>Manage @Model.Username</h2>
<a asp-action="Index">&larr; Back to users</a>
<a class="btn btn-outline-primary btn-sm ms-3" asp-action="Edit" asp-route-id="@Model.UserId">Edit details</a>

<div class="row mt-3">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">User ID</dt>
            <dd class="col-sm-8">@Model.UserId</dd>
            <dt class="col-sm-4">Username</dt>
            <dd class="col-sm-8">@Model.Username</dd>
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>
            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">@(Model.Address ?? "-")</dd>
            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@(Model.Phone ?? "-")</dd>
            <dt class="col-sm-4">Role</dt>
            <dd class="col-sm-8">@Model.Role</dd>
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">@(Model.IsActive ? "Active" : "Deactivated")</dd>
        </dl>
    </div>

    <div class="col-md-5">
        <h5>Reset password</h5>
        <form asp-action="ResetPassword" asp-route-id="@Model.UserId" method="post" class="mb-4">
            <div class="mb-2">
                <label for="NewPassword" class="form-label">New password (at least 8 characters)</label>
                <input type="password" id="NewPassword" name="NewPassword" class="form-control" autocomplete="new-password" required minlength="8" />
            </div>
            <button type="submit" class="btn btn-warning">Reset password</button>
        </form>

        @if (Model.IsActive && !isMe)
        {
            <h5>Deactivate user</h5>
            <p class="text-muted">They won't be able to sign in again.</p>
            <form asp-action="Deactivate" asp-route-id="@Model.UserId" method="post"
                  onsubmit="return confirm('Deactivate @Model.Username?');">
                <button type="submit" class="btn btn-danger">Deactivate</button>
            </form>
        }
    </div>
</div>
