@model BankMvc.Controllers.AdminUsersViewModel
@{
    ViewData["Title"] = "Users";
}

<h2>Users</h2>
<a class="btn btn-success" asp-action="Create">Create user</a>

@* filter form, GET so the filters stay in the url (easy to page with them) *@
<form method="get" asp-action="Index" class="row g-2 my-3">
    <div class="col-auto">
        <label class="form-label">Search (username, name, email or account number)</label>
        <input type="text" name="Search" value="@Model.Query.Search" class="form-control" placeholder="ex: smith" />
    </div>
    <div class="col-auto">
        <label class="form-label">Role</label>
        <select name="Role" class="form-select">
            <option value="">All</option>
            @foreach (var role in new[] { "Customer", "Admin" })
            {
                <option value="@role" selected="@(Model.Query.Role == role)">@role</option>
            }
        </select>
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
    </div>
</form>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.Result == null || !Model.Result.Items.Any())
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Username</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Result.Items)
            {
                <tr>
                    <td>@u.Username</td>
                    <td>@u.Name</td>
                    <td>@u.Email</td>
                    <td>@u.Role</td>
                    <td>
                        @if (u.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Deactivated</span>
                        }
                    </td>
                    <td><a asp-action="Details" asp-route-id="@u.UserId">Manage</a></td>
                </tr>
            }
        </tbody>
    </table>

    @* paging: previous / next links that keep the current filters *@
    var current = Model.Result.Page;
    var last = Model.Result.TotalPages;

    <nav>
        <ul class="pagination">
            <li class="page-item @(current <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-Search="@Model.Query.Search" asp-route-Role="@Model.Query.Role" asp-route-Page="@(current - 1)">Previous</a>
            </li>
            <li class="page-item @(current >= last ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-Search="@Model.Query.Search" asp-route-Role="@Model.Query.Role" asp-route-Page="@(current + 1)">Next</a>
            </li>
        </ul>
    </nav>
    <p class="text-muted">Page @current of @last (@Model.Result.TotalCount users)</p>
}
