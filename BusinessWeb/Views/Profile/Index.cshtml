@model BankMvc.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<h2>My Profile</h2>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row">
    <div class="col-md-4 mb-4">
        @if (Model.HasPicture)
        {
            <img src="@Url.Action("Picture")" alt="Profile picture" class="img-thumbnail mb-3" style="max-width: 220px;" />
        }
        else
        {
            <div class="border rounded text-muted text-center p-5 mb-3" style="max-width: 220px;">No picture yet</div>
        }

        @* enctype is needed to send a file *@
        <form asp-action="UploadPicture" method="post" enctype="multipart/form-data">
            <div class="mb-2">
                <label for="picture" class="form-label">Profile picture (.jpg or .png, max 2 MB)</label>
                <input type="file" id="picture" name="picture" class="form-control" accept=".jpg,.jpeg,.png" />
            </div>
            <button type="submit" class="btn btn-outline-primary">Upload picture</button>
        </form>
    </div>

    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Username</dt>
            <dd class="col-sm-8">@Model.Username</dd>
            <dt class="col-sm-4">Role</dt>
            <dd class="col-sm-8">@Model.Role</dd>
        </dl>

        <form asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autocomplete="name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">Address (optional)</label>
                <input asp-for="Address" class="form-control" autocomplete="street-address" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">Phone (optional)</label>
                <input asp-for="Phone" class="form-control" autocomplete="tel" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save changes</button>
        </form>

        <h5 class="mt-4">Change password</h5>
        <form asp-action="ChangePassword" method="post">
            <div class="mb-3">
                <label for="CurrentPassword" class="form-label">Current password</label>
                <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control" autocomplete="current-password" required />
            </div>
            <div class="mb-3">
                <label for="NewPassword" class="form-label">New password (at least 8 characters)</label>
                <input type="password" id="NewPassword" name="NewPassword" class="form-control" autocomplete="new-password" required minlength="8" />
            </div>
            <div class="mb-3">
                <label for="ConfirmPassword" class="form-label">Confirm new password</label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" autocomplete="new-password" required />
            </div>
            <button type="submit" class="btn btn-warning">Change password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
